# Website-only delivery; leave empty to offer honest call/email fallback.
# Use a sending-only Resend key for this website, never browser JavaScript.
RESEND_API_KEY=
# Must be an address on a domain verified with Resend.
INQUIRY_FROM=
INQUIRY_TO=Info@nanascozycorner.com
# Both required before the website offers direct form submission.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames, including the preview when testing.
INQUIRY_ALLOWED_HOSTS=www.nanascozycorner.com,nanascozycorner.com
